# Corporate Ladder: environment variables
# Copy to .env.local and fill in values from your Supabase project
# (Project Settings → API Keys). Never commit real values.
#
# Without these, the app runs in guest-only mode: local progress in the
# browser, no accounts, no verified play.

# Public: safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# (Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.)

# Secret: server only. Used solely to call the trusted SQL functions that start
# rounds, record hints and finalize results. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# (Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.)
